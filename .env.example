# felt-voice's address on your network (e.g. http://192.168.1.104:8421).
# Leave unset and TTS-read-aloud is simply skipped, not guessed.
FELT_AGENT_VOICE_URL=

# Port this agent's own HTTP API (KDE Connect battery/ring, etc.) listens on.
FELT_AGENT_API_PORT=8422

# Native desktop notifications (matched on D-Bus app_name). Comma-
# separated, case-insensitive. Empty = nothing read aloud from this list.
FELT_AGENT_ALLOWED_APPS=

# Phone notifications relayed via KDE Connect (matched on the
# notification's `summary`, since KDE Connect's own app_name is always
# "KDE Connect" regardless of the real source app). Comma-separated,
# case-insensitive.
FELT_AGENT_KDECONNECT_SOURCE_APPS=

# Substring match (case-insensitive) against an input device's name —
# e.g. "SteelSeries" — used to find a mouse whose horizontal-scroll
# wheel tilt toggles the Felt tray app's window. Empty = disabled.
# Needs the device readable by this user (see a udev rule tagging it
# `uaccess`, or group membership) — plain scroll-wheel input isn't
# something a normal keybinding tool can bind to at all.
FELT_AGENT_WHEEL_TOGGLE_DEVICE_NAME=

# Path to a custom-trained openWakeWord "Felt" model (.onnx). Empty =
# disabled — no pretrained model exists for this phrase (openWakeWord's
# bundled models only cover phrases like "hey jarvis"/"alexa"), so this
# stays unset until a real trained model file is deployed here. See
# wake_word.py and assistant-voice.md for how it was trained.
FELT_AGENT_WAKE_WORD_MODEL_PATH=
# Detection confidence threshold (0-1). openWakeWord's own docs suggest
# 0.5 as a sane default; raise it if false triggers happen, lower it if
# real "Felt" utterances get missed.
FELT_AGENT_WAKE_WORD_THRESHOLD=0.5
